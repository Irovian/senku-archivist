  "purpose": "Small pilot suite for checking whether generated and curated retrieval metadata can find expected EPP documents and artifacts.",
  "tests": [
    {
      "test_id": "RQ-001",
      "query": "Where can residents be evacuated to?",
      "query_family": "staff_task",
      "priority": "pilot",
      "expected_doc_ids": [
        "DOC-EVACUATION-RECEIVING_FACILITIES_FOR_EVACUATION"
      ],
      "acceptable_doc_ids": [
        "DOC-EVACUATION-RESIDENT_PLACEMENT_INTO_OTHER_FACILITIES",
        "DOC-EVACUATION-TRANSPORTATION_INTERNAL_EXTERNAL"
      ],
      "expected_artifact_types": [
        "receiving_facility_directory"
      ],
      "rationale": "A staff user looking for evacuation destinations should find the receiving-facility directory first."
    },
    {
      "test_id": "RQ-002",
      "query": "What form tracks residents during evacuation?",
      "query_family": "artifact_lookup",
      "priority": "pilot",
      "expected_doc_ids": [
        "DOC-EVACUATION-RESIDENT_EVACUATION_TRACKING_FORM"
      ],
      "acceptable_doc_ids": [
        "DOC-EVACUATION-RESIDENT_MEDICAL_RECORDS",
        "DOC-EVACUATION-CARE_AND_TREATMENT_OF_EVACUEES"
      ],
      "expected_artifact_types": [
        "fixed_page_form"
      ],
      "rationale": "Evacuation tracking should retrieve the dedicated resident evacuation tracking form."
    },
    {
