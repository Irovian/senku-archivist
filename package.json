{
  "name": "senku-archivist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "service": "python3 service/archivist_service.py",
    "launch": "scripts/launch_archivist_app.sh",
    "launch:status": "scripts/launch_archivist_app.sh --status",
    "launch:stop": "scripts/launch_archivist_app.sh --stop",
    "import:epp": "python3 scripts/import_epp_workspace.py",
    "check:epp-source-leaks": "python3 scripts/check_epp_workspace_source_leaks.py workspaces/epp-full",
    "check:epp-references": "python3 scripts/check_epp_workspace_references.py workspaces/epp-full",
    "smoke:service": "python3 scripts/smoke_archivist.py --mode service",
    "smoke:browser": "python3 scripts/smoke_archivist.py --mode browser",
    "smoke:all": "npm run build && npm run check:epp-source-leaks && npm run check:epp-references && python3 scripts/smoke_archivist.py --mode all"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
